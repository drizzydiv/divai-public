# divAI environment config
# Copy this to .env and fill in values. Never commit .env.

# Path to your Obsidian vault (leave blank to use local memory/ folder)
VAULT_PATH=D:\divAI

# Azure Neural TTS — get key at portal.azure.com > Cognitive Services > Speech
# Free tier: 500k characters/month. Leave blank to fall back to edge-tts.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
